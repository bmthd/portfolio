language js

or {
  `<$tag>$body</$tag>` where {
    $tag <: r"^[a-z][a-z0-9-]*$",
    register_diagnostic(
      span = $tag,
      message = "Do not use direct DOM elements. Use the project's design system instead.",
      severity = "error"
    )
  },
  `<$tag />` where {
    $tag <: r"^[a-z][a-z0-9-]*$",
    register_diagnostic(
      span = $tag,
      message = "Do not use direct DOM elements. Use the project's design system instead.",
      severity = "error"
    )
  },
  `<$tag $props />` where {
    $tag <: r"^[a-z][a-z0-9-]*$",
    register_diagnostic(
      span = $tag,
      message = "Do not use direct DOM elements. Use the project's design system instead.",
      severity = "error"
    )
  },
  `<$tag $props>$body</$tag>` where {
    $tag <: r"^[a-z][a-z0-9-]*$",
    register_diagnostic(
      span = $tag,
      message = "Do not use direct DOM elements. Use the project's design system instead.",
      severity = "error"
    )
  }
}